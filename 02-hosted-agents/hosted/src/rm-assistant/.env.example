# For LOCAL runs only. In Foundry, FOUNDRY_PROJECT_ENDPOINT and the App Insights
# connection string are injected automatically by the hosting platform.
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Pin the Foundry resource's Entra tenant so DefaultAzureCredential doesn't pick a
# token from another tenant you're signed into. Local-only; injected in Foundry.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# LOCAL ONLY: restrict DefaultAzureCredential to developer credentials (az login).
# Without this, the first call spends ~80s timing out on the managed-identity/IMDS
# probe that only exists inside the Foundry container. Do NOT set this in Foundry.
AZURE_TOKEN_CREDENTIALS=dev
