# ============================================================================
#  Microsoft Foundry Patterns — building, governing and operating agents
#  Fill this in, save as .env. Keyless-first: `az login` covers most of it.
# ============================================================================

# ---- Foundry project (Patterns 2, 3, 5, 6, 7, 8, 10, 12-15) ----
PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project
MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Entra tenant that owns the Foundry resource. Pin it so DefaultAzureCredential doesn't
# grab a token from another tenant you're signed into (causes "token tenant does not match
# resource tenant" errors — e.g. in the Pattern 7 eval workers). Find it: az account show.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# ---- AI gateway & model access / APIM (Pattern 1) ----
# KEYLESS Microsoft Entra ID by default (no static keys — best for regulated shops).
# The /your-project APIM API enforces a valid Entra token (validate-azure-ad-token);
# APIM reaches the AOAI backend with its own managed identity. Just run `az login`.
GATEWAY_ENDPOINT=https://your-apim-gateway.azure-api.net/your-project
# Leave blank for Entra. To demo the subscription-key fallback instead, set this to a
# project subscription key AND point GATEWAY_ENDPOINT at .../your-foundry-resource.
GATEWAY_KEY=
GATEWAY_MODEL=gpt-5.4-mini
# Classic /openai/deployments/ surface (raw chat.completions, Pattern 1):
GATEWAY_API_VERSION=2024-10-21
# Newer /openai/v1/ surface used by Agent Framework (Pattern 5): literal "preview".
GATEWAY_V1_API_VERSION=preview
# Entra token audience validated by the gateway policy:
GATEWAY_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

# ---- BYOM: route AGENT traffic through the gateway too (Patterns 2 and 6) ----
# GATEWAY_* above only covers calls YOUR CODE makes. When Foundry runs an agent
# server-side, *Foundry* calls the model — your client isn't in that loop. BYOM is
# the supported way to route it: set this to the name of a gateway connection on
# the Foundry project and Patterns 2 and 6 reference their model as
# "<connection>/<model>", which Foundry routes via APIM.
# Leave blank to keep agents on the direct Foundry route. See docs/coexistence.md.
AGENT_MODEL_CONNECTION=

# ---- Microsoft IQ (Pattern 3): Web IQ + Azure AI Search ----
# Web IQ runs through our MCP API on APIM. APIM Basic v2 uses a caller-facing
# subscription key here; APIM injects the separate upstream Web IQ credential
# from a secret named value and rate-limits before proxying.
# Setup (backend + api + policy) is in docs/coexistence.md.
WEBIQ_MCP_URL=
WEBIQ_APIM_KEY=
# Enterprise grounding uses the official Azure AI Search tool on a versioned
# Foundry agent. This is distinct from Pattern 2's managed File Search/vector store.
AI_SEARCH_CONNECTION_NAME=
AI_SEARCH_INDEX_NAME=
# Foundry IQ managed knowledge bases, Fabric IQ and Work IQ remain narrated
# product layers; this sample wires Web IQ and Azure AI Search directly.

# ---- Observability (Pattern 6) ----
# Leave BLANK to auto-resolve the App Insights connected to the Foundry project
# (this is what backs the portal 'Tracing' tab). Set a real connection string
# (InstrumentationKey=...) only to override. A resource ID is NOT accepted here.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# To also fan traces to your own OTel backend (Datadog/Grafana/Elastic):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://<your-collector>:4317
# Enterprise-safe default: metadata/model/tool/tokens/latency only. Set true only
# when prompt/completion bodies are approved for the telemetry access + retention policy.
# The script maps this to OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT.
TRACE_CONTENT_RECORDING=false

# ---- Evaluation & release gate (Pattern 7) ----
# No additional config. run_eval.py uses PROJECT_ENDPOINT + MODEL_DEPLOYMENT_NAME
# to generate candidate answers and judge them server-side in Foundry, keyless.
# Default CI can pass and fails closed on errors, missing metrics or metric failures.

# ---- AI safety / Prompt Shields + Content Safety (Pattern 8) ----
# Runs LIVE and keyless on the Foundry AI Services account (PROJECT_ENDPOINT) by
# default — no separate resource needed. Set these ONLY to point at a standalone
# Content Safety resource instead (CONTENT_SAFETY_KEY enables key auth).
CONTENT_SAFETY_ENDPOINT=
CONTENT_SAFETY_KEY=

# ---- AWS cross-cloud interop (Pattern 9) ----
# Slide + code walkthrough only (no AWS access in this environment). When you
# have AWS, point these at the real Lambda and the mock server drops out.
AWS_REGION=eu-west-1
AWS_LAMBDA_FUNCTION_NAME=foundry-interop-demo

# ---- Memory (Pattern 10) ----
# Long-term memory needs a chat model AND an embedding deployment. Both already
# exist on the Foundry account; override only if you use different deployments.
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small

# ---- Cost & latency (Pattern 11) ----
# Model Router deployment name (routes to the cheapest capable model). Prompt
# caching needs no config — it's on by default for supported models.
MODEL_ROUTER_DEPLOYMENT=model-router

# ---- Centralized Toolboxes (Pattern 12) ----
# No config needed. toolbox_demo.py curates tools into a toolbox on PROJECT_ENDPOINT
# and consumes them over MCP, keyless. Note the token audience is
# https://ai.azure.com — the cognitiveservices scope the other patterns use gets a
# 401 on the toolbox endpoint. Override the toolbox name only if you want a second one.
TOOLBOX_NAME=rm-toolbox
# Set true to put Pattern 3's APIM-governed Web IQ route inside the toolbox.
# Create a Foundry project connection that targets the APIM MCP endpoint and stores
# the Basic v2 subscription key server-side, then set its name below. The toolbox
# receives only the connection ID; it never reads WEBIQ_APIM_KEY. Off by default
# because APIM also meters toolbox tool enumeration.
TOOLBOX_INCLUDE_WEBIQ=
TOOLBOX_WEBIQ_CONNECTION_NAME=

# ---- Human approval for consequential actions (Pattern 13) ----
# Foundry cannot call localhost. Deploy the sample MCP service remotely, then store its
# endpoint + x-mcp-api-key (the TOOL key only) in a Foundry project connection.
MCP_CHANGE_CONTROL_URL=https://your-change-control-app.example/mcp
MCP_CHANGE_CONTROL_CONNECTION_NAME=change-control-mcp
# Separate process-only credentials. Never use the tool key on operator routes or give
# the operator key to the Foundry connection.
MCP_CHANGE_CONTROL_TOOL_API_KEY=
MCP_CHANGE_CONTROL_OPERATOR_API_KEY=

# ---- Model adaptation / fine-tuning (Pattern 14) ----
# Fine-tuning through a Foundry project endpoint currently requires the resource's
# DEFAULT project. The Cognitive Services account ID is needed for deployment/cleanup.
FINETUNE_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-default-project
FINETUNE_RESOURCE_ID=/subscriptions/<subscription>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-resource>
FINETUNE_REGION=swedencentral
FINETUNE_BASE_MODEL=gpt-4.1-mini
FINETUNE_BASE_MODEL_VERSION=2025-04-14
FINETUNE_BASE_DEPLOYMENT=gpt-4.1-mini
# Case-sensitive current wire values: Standard | GlobalStandard | developerTier.
FINETUNE_TRAINING_TYPE=developerTier
# ARM 2026-07-01 evaluation-only deployment wire SKU. Older examples may differ.
FINETUNE_DEPLOYMENT_SKU=DeveloperTier
# Prefix only; the pipeline appends a verified job-derived suffix and never reuses a
# shared static deployment name.
FINETUNE_DEPLOYMENT_NAME=triage-adapted-eval
# Capture the CURRENT approved rate before --confirm-cost; no price is hard-coded.
FINETUNE_TRAINING_PRICE_PER_MILLION_USD=

# ---- Agent lifecycle & promotion (Pattern 15) ----
# Use three distinct projects. They may share one resource for the demo or be isolated
# across resources/subscriptions/regions in stricter environments.
LIFECYCLE_DEV_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/pattern-lifecycle-dev
LIFECYCLE_TEST_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/pattern-lifecycle-test
LIFECYCLE_PROD_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/pattern-lifecycle-prod
LIFECYCLE_MODEL_DEPLOYMENT=gpt-5.4-mini
# Required for release/rollback records (32+ high-entropy bytes; store as a GitHub secret).
LIFECYCLE_RECORD_SIGNING_KEY=
# Optional aliases; when configured, the pipeline verifies that they resolve per project.
LIFECYCLE_KNOWLEDGE_CONNECTION=
LIFECYCLE_TOOLBOX_NAME=
LIFECYCLE_TOOLBOX_VERSION=
