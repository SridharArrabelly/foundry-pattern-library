# Local runs only. Foundry injects the project endpoint into the hosted workload.
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Pin the tenant for local DefaultAzureCredential and skip managed identity probes.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_TOKEN_CREDENTIALS=dev
